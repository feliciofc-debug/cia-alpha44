# =============================================================================
# CIA / Alpha 44 — variáveis de ambiente
# Copie para .env (local) ou configure nos painéis Render / Vercel (produção).
# =============================================================================

# ---- API (local ou Render) ----
PORT=3333
HOST=0.0.0.0
NODE_ENV=development

# CORS: origens permitidas (vírgula). Produção VPS: Vercel + localhost dev.
# Exemplo produção: https://cia-alpha44-web.vercel.app,http://localhost:5173
WEB_ORIGIN=http://localhost:5173

# ---- IA ----
# LLM_PROVIDER: anthropic | openai | mock | auto (default: auto)
LLM_PROVIDER=auto
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ---- Portal Único Siscomex (NCM oficial — desligado por padrão) ----
# SISCOMEX_PROVIDER: portal-unico | stub | auto (default: auto)
# SISCOMEX_AMBIENTE: validacao | homologacao | producao
# Opção A — certificado e-CNPJ A1 na VPS (recomendado):
# SISCOMEX_CERT_PATH=/etc/cia-alpha44/certs/alpha44.pfx
# SISCOMEX_CERT_PASSWORD=
# Opção B — chaves de acesso geradas no Portal Único:
# SISCOMEX_CLIENT_ID=
# SISCOMEX_CLIENT_SECRET=
# SISCOMEX_ATIVO=true   # consultas CLSF/TTCE ao vivo com certificado
# SISCOMEX_ROLE_TYPE=IMPEXP
# SISCOMEX_CODIGO_PAIS=160   # China (ComexStat / origem padrão)
# Guia: docs/SISCOMEX.md

# ---- OCR (PDF / imagem) — https://ocr.space/ocrapi/freekey.aspx ----
# OCR_PROVIDER: ocrspace | http | mock | auto
OCR_PROVIDER=auto
OCR_API_KEY=
OCR_API_URL=
OCR_LANGUAGE=chs
OCR_API_HEADER=Authorization

# ---- Banco (Render Postgres ou túnel VPS) ----
DATABASE_URL=

# ---- NCM Helper (Lovable/Gemini — conciliação informativa) ----
# Base URL ou endpoints completos (nunca hardcode preview em código)
NCM_HELPER_BASE_URL=https://ncm-helper-ai.lovable.app
# Classificação NCM: planilha IMPORTAÇÕES DA CHINA primeiro; gemini = fallback/validação visual.
# Produção VPS: manter gemini + vision=1 para validar/vetar NCM da planilha China com foto.
# legacy/off = só Anthropic 2-passes (sem Lovable/Gemini/visão)
CLASSIFICACAO_NCM_PROVIDER=gemini
CLASSIFICACAO_NCM_VISION=1
# NCM_HELPER_SUGERIR_URL=https://ncm-helper-ai.lovable.app/api/public/sugerir-ncm
# NCM_HELPER_LOOKUP_URL=https://ncm-helper-ai.lovable.app/api/public/lookup-ncm

# ---- Frontend (local ou Vercel) ----
# Produção: URL pública da API Render, sem barra final
VITE_API_URL=http://localhost:3333

# ---- Auth próprio (API + Vercel) ----
# VPS (interativo, recomendado): node tools/configurar-auth.mjs
# Manual: node tools/gerar-hash-senha.mjs <senha>
# CIA_USERS="email1:hashBcrypt1,email2:hashBcrypt2"
CIA_USERS=
# Segredo para assinar JWT (mín. 32 caracteres aleatórios)
CIA_JWT_SECRET=
# Integrações/scripts: x-api-key (opcional, convive com JWT)
CIA_API_KEY=
CIA_API_TENANT_SLUG=default
# Dev sem login: header x-demo-auth:1 (front envia automaticamente se sem token). Desligar: AUTH_DEMO_FALLBACK=off
AUTH_DEMO_FALLBACK=
# Rate limit (por tenant/hora)
# RL_CLASSIFICAR_MAX=30
# RL_PARSE_MAX=30
# RL_NCM_CONFERIR_MAX=120
