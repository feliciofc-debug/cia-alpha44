# Copie para .env na VPS (NUNCA commite o .env com senha real).
#   cp .env.example .env
#   nano .env

POSTGRES_USER=cia_app
POSTGRES_PASSWORD=
POSTGRES_DB=cia_alpha44

# Para Prisma / API (no seu PC ou na VPS, via túnel SSH):
# DATABASE_URL=postgresql://cia_app:SUA_SENHA@127.0.0.1:5432/cia_alpha44

# Defaults não-secretos que deploy-api.sh garante em /etc/cia-alpha44/api.env.
# Mantêm a visão NCM ativa em produção após deploy limpo/recriação do api.env.
CLASSIFICACAO_NCM_PROVIDER=gemini
CLASSIFICACAO_NCM_VISION=1
NCM_HELPER_BASE_URL=https://ncm-helper-ai.lovable.app

# Fotos temporárias do parse (defaults: apps/api/data/parse-fotos e 168 horas).
# PARSE_FOTOS_DIR=/var/lib/cia-alpha44/parse-fotos
PARSE_FOTOS_TTL_HORAS=168

# Upload grande (somente tenants com upgradeUpload).
# UPLOAD_GRANDE_MAX_MB=130
# UPLOAD_GRANDE_MULTIPART_MARGIN_MB=10
# PARSE_UPLOAD_TMP_DIR=/var/lib/cia-alpha44/parse-uploads
# PARSE_UPLOAD_TMP_TTL_HORAS=24
# PARSE_ZIP_MAX_UNCOMPRESSED_MB=512
# PARSE_ZIP_MAX_ENTRIES=10000
# PARSE_ZIP_MAX_IMAGE_MB=25
# PARSE_COTA_TENANT_MB=1024
# PARSE_COTA_GLOBAL_MB=8192

# Feature paga por tenant; arquivo JSON recarregado sem restart.
CIA_FEATURES_PATH=/etc/cia-alpha44/features.json
